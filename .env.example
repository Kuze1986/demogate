# DemoForge — copy to .env.local and set values (never commit secrets)

# Supabase (nexus-core)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
# Legacy alias supported by Ilita / Axis helpers:
# SUPABASE_SERVICE_ROLE_KEY=

# App
APP_NAME=DemoForge
NEXT_PUBLIC_APP_URL=https://your-demoforge.up.railway.app
ADMIN_EMAIL=

# AI (in-process Kuze / routing / follow-up copy)
ANTHROPIC_API_KEY=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@your-verified-domain.com

# Optional NEXUS connections
# When set, post-demo Axis lead + touch is written via Supabase `axis` schema (same project URL + service key).
AXIS_URL=1
NEXT_PUBLIC_CRUCIBLE_URL=
CRUCIBLE_SIM_BASE_URL=
CRUCIBLE_SIM_API_KEY=

# Stripe / video worker (if used)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# REDIS_URL=
